# Copy to .env and fill in. Only the first two are required.

# ── Required ─────────────────────────────────────────────────────────────────

# Analyses the product, judges every channel, writes the outreach. Chanlyst
# does nothing without it. https://openrouter.ai
OPENROUTER_API_KEY=

# Owner sign-in, so you can get in without setting up any OAuth app.
#   node scripts/hash-password.mjs 'your password'
# The hash contains $ signs. docker compose reads this file literally and is
# fine with that; a shell is not, so do NOT load it with `source .env` or
# `export $(cat .env)` — both eat everything from the first $ onwards, and you
# get a silent 401 on a password that is perfectly correct.
OWNER_LOGIN=owner
OWNER_PASSWORD_HASH=

# ── Strongly recommended ─────────────────────────────────────────────────────

# Google search, and the difference is not small. A broad run costs about
# $0.05 with Serper and about $1.17 without, because the model otherwise
# searches for itself and every result it pulls arrives as input tokens at the
# expensive model's prices. Telegram channels, contact-page lookup and the
# competitor gap need it. 2,500 free queries: https://serper.dev
SERPER_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Sending from your own Gmail. Without it, messages are drafted and copied and
# you send them yourself — which is how Telegram and LinkedIn work anyway.
# Redirect URI: <PUBLIC_BASE_URL>/api/integrations/gmail/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Encrypts the OAuth tokens above at rest. Needed once you connect anything.
#   openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Sign-in links by e-mail, as an alternative to the owner password.
RESEND_API_KEY=
MAIL_FROM=

# The address a browser uses to reach this install. Leave as-is for a local
# run; set it to your domain once it is behind one, or OAuth redirects and the
# links inside generated e-mails will point at localhost.
PUBLIC_BASE_URL=http://localhost:3000

# No plan limits and no subscription section: the quotas exist to price the
# hosted service, and here the API calls are billed to you already.
SELF_HOST=1

# A cheaper model for the bounded classification steps. The default is fine.
# OPENROUTER_MODEL=openai/gpt-5.2
# DISCOVERY_CLASSIFIER_MODEL=openai/gpt-5-mini
