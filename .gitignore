# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template the whole install depends on has to ship. Without this
# line `.env*` hides it and a fresh clone has nothing to copy from.
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
tsconfig.tsbuildinfo
.dev.vars

# The operator's own deploy target. Never published.
deploy/host.local

# The Remotion project's own build output and dependencies. The compositions
# and the captured frames are tracked; a 38MB render is not.
video/node_modules
video/out
