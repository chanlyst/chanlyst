[Unit]
Description=Chanlyst scheduled outreach engine
After=network-online.target chanlyst.service

[Service]
Type=oneshot
EnvironmentFile=/etc/chanlyst/chanlyst.env
ExecStart=/bin/sh -c 'exec /usr/bin/curl --fail --silent --show-error --retry 6 --retry-connrefused --retry-all-errors --retry-delay 2 --max-time 120 -X POST -H "Authorization: Bearer $AGENT_CRON_SECRET" -H "Content-Type: application/json" --data "{\"mode\":\"cron\"}" http://127.0.0.1:3000/api/outreach-engine/run'
