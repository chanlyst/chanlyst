# Canonical origin used for OAuth redirects and absolute links.
PUBLIC_BASE_URL=https://chanlyst.com

# Workspaces exempt from plan limits (comma-separated ids), e.g. the owner's.
UNLIMITED_WORKSPACE_IDS=

# The product whose channel run is published at /found.
#
# Without this the page falls back to whichever product has chanlyst.com as its
# website, which is correct but guessable: a customer who enters our domain as
# their own product's website would be published instead. Set it.
FOUND_PRODUCT_ID=

# Core AI and encryption
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.2
AGENT_CRON_SECRET=replace-with-a-random-secret
INTEGRATION_ENCRYPTION_KEY=

# Structured candidate harvesting. When configured, Chanlyst runs three cheap
# deterministic searches for every discovery lane and gives those candidates
# to the classifier. Without it, the existing OpenRouter web search remains a
# functional fallback.
SERPER_API_KEY=
# Cheap structured-output classifier used after Serper supplies candidates.
DISCOVERY_CLASSIFIER_MODEL=openai/gpt-5-mini

# Optional later-stage enrichment providers. They are not required for the
# core search and must never be committed with real values.
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# Channel-discovery web-search budget. Leave empty to keep the defaults below.
#
# Measured on 11 production discover runs (ai_usage): avg $0.158 per run,
# 33 800 input tokens, of which only ~1 300 are the prompt itself — the other
# ~32 000 are web-search results injected into the context by the
# openrouter:web_search tool. The search budget, not the prompt, is what the
# discovery bill is made of: injected context scales roughly linearly with
# DISCOVERY_MAX_TOTAL_RESULTS, so halving it should cut close to half the
# per-run input cost. Quality impact is unmeasured — lower it deliberately.
#
# DISCOVERY_MAX_RESULTS       results per single search   (default 4,  1–20)
# DISCOVERY_MAX_TOTAL_RESULTS results across the whole run(default 10, 1–50)
# DISCOVERY_MAX_TOOL_CALLS    max searches per run        (default 4,  1–10)
# DISCOVERY_MAX_OUTPUT_TOKENS answer cap                  (default 5000, 500–32000)
# Out-of-range or unparseable values fall back to the defaults.
DISCOVERY_MAX_RESULTS=
DISCOVERY_MAX_TOTAL_RESULTS=
DISCOVERY_MAX_TOOL_CALLS=
DISCOVERY_MAX_OUTPUT_TOKENS=

# "Prepare everything for me" pipeline caps (chanlyst-pipeline.timer).
#
# The pipeline runs analysis → discovery → contact enrichment → drafting for a
# single product and leaves everything as DRAFTS. Enrichment is the expensive
# step (~$0.04–0.05 per contact, measured in ai_usage), so it is capped per
# run; sequence drafting costs one outreach generation per channel.
#
# PIPELINE_MAX_ENRICH    channels enriched per run   (default 10, clamped 0–40)
# PIPELINE_MAX_SEQUENCES channels with a 3-email
#                        sequence draft per run      (default 5,  clamped 0–20)
# Empty or unparseable values fall back to the defaults. Every step still goes
# through the normal plan quotas, so these caps only lower the ceiling.
PIPELINE_MAX_ENRICH=
PIPELINE_MAX_SEQUENCES=

# Who may open /admin, the cross-workspace operations panel. Comma-separated
# addresses; leave empty and the page answers 404 to everybody, which is what
# every machine except production should do.
ADMIN_EMAILS=

# Emergency owner sign-in
OWNER_LOGIN=owner
# Format: pbkdf2:310000:base64_salt:base64_hash
OWNER_PASSWORD_HASH=

# Sign in with Google
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the PKCS#8 .p8 key with newlines escaped as \n.
APPLE_PRIVATE_KEY=

# Sign in with GitHub. Create an OAuth App and set the callback URL to
# https://chanlyst.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Passwordless e-mail sign-in (magic link) delivered through Resend.
# Both values are required; without them the login form hides the e-mail field.
RESEND_API_KEY=
# Verified sender, e.g. Chanlyst <login@chanlyst.com>
MAIL_FROM=

# Which provider takes payments: "gumroad" or "lemon_squeezy".
# Unset — whichever one is configured; both may stay filled in at once, so
# switching back is a one-line change.
BILLING_PROVIDER=

# Lemon Squeezy billing
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Set to "true" only in staging: lets test-mode webhooks grant paid plans.
LEMONSQUEEZY_ALLOW_TEST_MODE=
# Optional overrides when the store is copied from Test mode to Live mode.
LEMON_SQUEEZY_STARTER_MONTHLY_CHECKOUT_URL=
LEMON_SQUEEZY_STARTER_ANNUAL_CHECKOUT_URL=
LEMON_SQUEEZY_MONTHLY_CHECKOUT_URL=
LEMON_SQUEEZY_ANNUAL_CHECKOUT_URL=
LEMON_SQUEEZY_SCALE_MONTHLY_CHECKOUT_URL=
LEMON_SQUEEZY_SCALE_ANNUAL_CHECKOUT_URL=

# Gumroad billing.
# Token from "Generate access token" on the application page in Settings →
# Advanced. The webhook reads every sale back through the API with it, so
# without this the webhook rejects everything.
GUMROAD_ACCESS_TOKEN=
# Shown under the Ping field in Settings → Advanced. Rejects webhooks that
# come from another seller.
GUMROAD_SELLER_ID=
# The secret from the Ping URL query string. Gumroad does not sign its
# webhooks, so this is the first of the two authenticity checks.
GUMROAD_WEBHOOK_TOKEN=
# Product links. The plan is derived from the permalink at the end of each
# URL, so these double as the plan mapping — no separate product-id list.
GUMROAD_STARTER_MONTHLY_URL=
GUMROAD_STARTER_ANNUAL_URL=
GUMROAD_PRO_MONTHLY_URL=
GUMROAD_PRO_ANNUAL_URL=
GUMROAD_SCALE_MONTHLY_URL=
GUMROAD_SCALE_ANNUAL_URL=

# Optional Gmail sending integration defaults
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
